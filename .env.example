# Professional SMART - Environment Configuration Template
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:ClearToFly1@localhost:5432/pro_smart_dev

# Database pool settings
# PHASE 6: Optimized for high-throughput batch processing
DB_MAX_CONNECTIONS=100        # Increased from 50 for parallel processing
DB_MIN_CONNECTIONS=10         # Increased from 5 for faster startup
DB_ACQUIRE_TIMEOUT=30         # Connection acquisition timeout (seconds)
DB_IDLE_TIMEOUT=600           # Close idle connections after 10 minutes
DB_MAX_LIFETIME=1800          # Max connection lifetime: 30 minutes

# PHASE 5 & 6: Performance tuning
# Prepared statement cache size per connection (default: 100)
DB_STATEMENT_CACHE_CAPACITY=200  # Increased from 100 for better cache hits
# Statement timeout in seconds (default: 30)
DB_STATEMENT_TIMEOUT=30
# Test connections before acquiring (default: true)
DB_TEST_BEFORE_ACQUIRE=true

# ============================================================================
# Application Server Configuration
# ============================================================================
# Server host and port
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Base URL for the application
BASE_URL=http://localhost:8080

# ============================================================================
# Logging Configuration
# ============================================================================
# Simple log level control (recommended for most users)
# Valid values: trace, debug, info, warn, error
# - trace: Most verbose - all trace logs (very noisy, for debugging only)
# - debug: Debug and above (useful for troubleshooting issues)
# - info:  Info, warn, error (recommended for production)
# - warn:  Warnings and errors only
# - error: Errors only (minimal logging)
LOG_LEVEL=info

# Advanced logging (optional - overrides LOG_LEVEL if set)
# Can be set per-module: RUST_LOG=info,pro_worker=debug,sqlx=warn
# RUST_LOG=info

# Log format: json or pretty
LOG_FORMAT=pretty

# ============================================================================
# Environment Settings
# ============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Feature flags
ENABLE_METRICS=true
ENABLE_TRACING=false

# ============================================================================
# Worker Configuration
# ============================================================================
# Batch processing settings
BATCH_SIZE=100
MAX_CONCURRENT_BATCHES=4

# File processing paths
IMPORT_PATH=./data/import
ARCHIVE_PATH=./data/archive
ERROR_PATH=./data/errors

# PHASE 5: Streaming processing
ENABLE_STREAMING=false
STREAMING_CHANNEL_CAPACITY=100
STREAMING_MAX_CONCURRENT_CLAIMS=4
STREAMING_ENABLE_WEBSOCKET=true
STREAMING_ENABLE_PROGRESS_TRACKING=true

# PHASE 5: WebSocket server
WEBSOCKET_HOST=127.0.0.1:8080

# ============================================================================
# Performance Tuning
# ============================================================================
# Rule engine cache TTL (seconds)
RULE_CACHE_TTL=3600

# Enable parallel rule execution
ENABLE_PARALLEL_RULES=true

# ============================================================================
# Rules Engine Configuration (CRITICAL FOR PERFORMANCE)
# ============================================================================
# Enable database-driven rules (requires RULE_ENCRYPTION_KEY)
# When true: Rules loaded from claims.rule_definition table
# When false: No rules executed during import (fastest throughput)
ENABLE_DATABASE_RULES=true

# Deferred rules execution for high-throughput import
# AUTO-DETECTION: When not set, auto-defers if rule count >= 100 (RECOMMENDED)
# true:  Always defer rules to background processing (fastest import, flags after)
# false: Always execute rules inline during import (slower, immediate flags)
#
# With 500+ rules, inline execution limits throughput to ~5 claims/sec
# Deferred mode achieves 300-500 claims/sec (10K claims in 20-30 sec)
# DEFER_RULES_EXECUTION=true

# Rule encryption key (required when ENABLE_DATABASE_RULES=true)
# Must match the key used to encrypt rules in the database
RULE_ENCRYPTION_KEY=ProfessionalSmartRulesKey2024

# ============================================================================
# Security Settings
# ============================================================================
# JWT secret for API authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your-secret-key-here-change-in-production

# API rate limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=60

# ============================================================================
# Integration Settings (if applicable)
# ============================================================================
# External API endpoints
# PAYER_API_URL=https://api.payer.example.com
# PAYER_API_KEY=your-api-key-here

# ============================================================================
# Development Settings (development only)
# ============================================================================
# Enable SQL query logging
SQLX_LOGGING=false

# Pretty print JSON responses
PRETTY_JSON=true

# Disable authentication for local development
DEV_DISABLE_AUTH=true

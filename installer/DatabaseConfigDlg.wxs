<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <UI>
      <Dialog Id="DatabaseConfigDlg" Width="370" Height="270" Title="[ProductName] - Database Configuration">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Database Configuration" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Please enter your PostgreSQL database connection details." />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <!-- Database Host -->
        <Control Id="HostLabel" Type="Text" X="20" Y="60" Width="100" Height="15" Text="Database Host:" />
        <Control Id="HostEdit" Type="Edit" X="130" Y="58" Width="220" Height="18" Property="DB_HOST" />

        <!-- Database Port -->
        <Control Id="PortLabel" Type="Text" X="20" Y="85" Width="100" Height="15" Text="Database Port:" />
        <Control Id="PortEdit" Type="Edit" X="130" Y="83" Width="220" Height="18" Property="DB_PORT" />

        <!-- Database Name -->
        <Control Id="NameLabel" Type="Text" X="20" Y="110" Width="100" Height="15" Text="Database Name:" />
        <Control Id="NameEdit" Type="Edit" X="130" Y="108" Width="220" Height="18" Property="DB_NAME" />

        <!-- Database User -->
        <Control Id="UserLabel" Type="Text" X="20" Y="135" Width="100" Height="15" Text="Database User:" />
        <Control Id="UserEdit" Type="Edit" X="130" Y="133" Width="220" Height="18" Property="DB_USER" />

        <!-- Database Password -->
        <Control Id="PasswordLabel" Type="Text" X="20" Y="160" Width="100" Height="15" Text="Database Password:" />
        <Control Id="PasswordEdit" Type="Edit" X="130" Y="158" Width="220" Height="18" Property="DB_PASSWORD" Password="yes" />

        <!-- Help Text -->
        <Control Id="HelpText" Type="Text" X="20" Y="190" Width="330" Height="35" Text="These settings will be saved to the configuration file. Database schemas will be created automatically during setup." />

        <!-- Navigation Buttons -->
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back">
          <Publish Event="NewDialog" Value="CustomizeDlg">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>

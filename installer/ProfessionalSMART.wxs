            </Feature>
            <Feature Id="StartMenuShortcuts" Description="Shortcuts in the Start Menu" Level="1" Title="Start Menu Shortcuts">
                <ComponentRef Id="ApplicationShortcuts" />
            </Feature>
        </Feature>
        <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Professional SMART is already installed." Schedule="afterInstallFinalize" />
        <Media Id="1" Cabinet="cab1.cab" EmbedCab="yes" />
        <Property Id="DB_HOST" Value="localhost" />
        <Property Id="DB_PORT" Value="5432" />
        <Property Id="DB_NAME" Value="professional_smart" />
        <Property Id="DB_USER" Value="postgres" />
        <Property Id="ALLUSERS" Value="1" />
        <Property Id="PREREQ_PSQL_STATUS" Value="CHECKING" />
        <Property Id="PREREQ_PGSERVICE_STATUS" Value="CHECKING" />
        <Property Id="PREREQ_DISK_STATUS" Value="CHECKING" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/professional-smart" />
        <Property Id="ARPCONTACT" Value="support@professional-smart.com" />
        <Property Id="ARPCOMMENTS" Value="Healthcare claims processing system with comprehensive rules engine and RVU-based payment calculations" />
        <Property Id="INSTALLMODE" Value="FRESH" />
        <Property Id="CREATE_BACKUP" Value="1" />
        <Property Id="ENV_CREDENTIALS_LOADED" Value="0" />
        <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
        <Property Id="REBOOT" Value="ReallySuppress" />
        <Property Id="PREREQ_MESSAGE" Value="Checking prerequisites..." />
        <Property Id="WIX_DOWNGRADE_DETECTED" Secure="yes" />
        <Property Id="WIX_UPGRADE_DETECTED" Secure="yes" />
        <Property Id="DB_PASSWORD" Hidden="yes" />
        <UI>
            <Dialog Id="PrerequisiteDlg" X="50" Y="50" Width="370" Height="270" Title="[ProductName] - Prerequisites Check">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner" TabSkip="no" Disabled="yes" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back" TabSkip="no">
                    <Publish Event="NewDialog" Value="WelcomeDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Next" TabSkip="no" Default="yes">
                    <Publish Event="NewDialog" Value="CustomizeDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel" TabSkip="no" Cancel="yes">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
                <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Text="Checking system requirements for Professional SMART" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Text="{\WixUI_Font_Title}Prerequisites Check" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" TabSkip="yes" Disabled="yes" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" TabSkip="yes" Disabled="yes" />
                <Control Id="PostgreSQLLabel" Type="Text" X="25" Y="60" Width="250" Height="15" Text="PostgreSQL (psql command):" TabSkip="yes" />
                <Control Id="PostgreSQLStatus" Type="Text" X="280" Y="60" Width="70" Height="15" Text="[PREREQ_PSQL_STATUS]" TabSkip="yes">
                    <Condition Action="show">PREREQ_PSQL_STATUS</Condition>
                </Control>
                <Control Id="PostgreSQLServiceLabel" Type="Text" X="25" Y="80" Width="250" Height="15" Text="PostgreSQL Service:" TabSkip="yes" />
                <Control Id="PostgreSQLServiceStatus" Type="Text" X="280" Y="80" Width="70" Height="15" Text="[PREREQ_PGSERVICE_STATUS]" TabSkip="yes">
                    <Condition Action="show">PREREQ_PGSERVICE_STATUS</Condition>
                </Control>
                <Control Id="DiskSpaceLabel" Type="Text" X="25" Y="100" Width="250" Height="15" Text="Disk Space (500 MB required):" TabSkip="yes" />
                <Control Id="DiskSpaceStatus" Type="Text" X="280" Y="100" Width="70" Height="15" Text="[PREREQ_DISK_STATUS]" TabSkip="yes">
                    <Condition Action="show">PREREQ_DISK_STATUS</Condition>
                </Control>
                <Control Id="StatusMessage" Type="Text" X="25" Y="130" Width="320" Height="40" Text="[PREREQ_MESSAGE]" TabSkip="yes" />
                <Control Id="WarningText" Type="Text" X="25" Y="180" Width="320" Height="30" Text="Note: PostgreSQL must be installed and running for database creation to succeed. The installer will continue, but you may need to create the database manually if PostgreSQL is not available." TabSkip="yes" />
            </Dialog>
            <Dialog Id="DatabaseConfigDlg" X="50" Y="50" Width="370" Height="270" Title="[ProductName] - Database Configuration">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Text="WixUI_Bmp_Banner" TabSkip="no" Disabled="yes" />
                <Control Id="HostEdit" Type="Edit" X="130" Y="58" Width="220" Height="18" Property="DB_HOST" TabSkip="no" />
                <Control Id="PortEdit" Type="Edit" X="130" Y="83" Width="220" Height="18" Property="DB_PORT" TabSkip="no" />
                <Control Id="NameEdit" Type="Edit" X="130" Y="108" Width="220" Height="18" Property="DB_NAME" TabSkip="no" />
                <Control Id="UserEdit" Type="Edit" X="130" Y="133" Width="220" Height="18" Property="DB_USER" TabSkip="no" />
                <Control Id="PasswordEdit" Type="Edit" X="130" Y="158" Width="220" Height="18" Property="DB_PASSWORD" TabSkip="no" Password="yes" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="&amp;Back" TabSkip="no">
                    <Publish Event="NewDialog" Value="CustomizeDlg">1</Publish>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Text="&amp;Next" TabSkip="no" Default="yes">
                    <Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Text="Cancel" TabSkip="no" Cancel="yes">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
                <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Text="Please enter your PostgreSQL database connection details." TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Text="{\WixUI_Font_Title}Database Configuration" TabSkip="yes" Transparent="yes" NoPrefix="yes" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" TabSkip="yes" Disabled="yes" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" TabSkip="yes" Disabled="yes" />
                <Control Id="HostLabel" Type="Text" X="20" Y="60" Width="100" Height="15" Text="Database Host:" TabSkip="yes" />
                <Control Id="PortLabel" Type="Text" X="20" Y="85" Width="100" Height="15" Text="Database Port:" TabSkip="yes" />
                <Control Id="NameLabel" Type="Text" X="20" Y="110" Width="100" Height="15" Text="Database Name:" TabSkip="yes" />
                <Control Id="UserLabel" Type="Text" X="20" Y="135" Width="100" Height="15" Text="Database User:" TabSkip="yes" />
                <Control Id="PasswordLabel" Type="Text" X="20" Y="160" Width="100" Height="15" Text="Database Password:" TabSkip="yes" />
                <Control Id="HelpText" Type="Text" X="20" Y="190" Width="330" Height="35" Text="These settings will be saved to the configuration file. Database schemas will be created automatically during setup." TabSkip="yes" />
            </Dialog>
        </UI>
        <UIRef Id="WixUI_FeatureTree" />
        <InstallExecuteSequence>

<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <UI>
      <Dialog Id="PrerequisiteDlg" Width="370" Height="270" Title="[ProductName] - Prerequisites Check">

        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Prerequisites Check</Text>
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>Checking system requirements for Professional SMART</Text>
        </Control>

        <!-- PostgreSQL Check -->
        <Control Id="PostgreSQLLabel" Type="Text" X="25" Y="60" Width="250" Height="15" Text="PostgreSQL (psql command):" />
        <Control Id="PostgreSQLStatus" Type="Text" X="280" Y="60" Width="70" Height="15" Text="[PREREQ_PSQL_STATUS]">
          <Condition Action="show">PREREQ_PSQL_STATUS</Condition>
        </Control>

        <!-- PostgreSQL Service Check -->
        <Control Id="PostgreSQLServiceLabel" Type="Text" X="25" Y="80" Width="250" Height="15" Text="PostgreSQL Service:" />
        <Control Id="PostgreSQLServiceStatus" Type="Text" X="280" Y="80" Width="70" Height="15" Text="[PREREQ_PGSERVICE_STATUS]">
          <Condition Action="show">PREREQ_PGSERVICE_STATUS</Condition>
        </Control>

        <!-- Disk Space Check -->
        <Control Id="DiskSpaceLabel" Type="Text" X="25" Y="100" Width="250" Height="15" Text="Disk Space (500 MB required):" />
        <Control Id="DiskSpaceStatus" Type="Text" X="280" Y="100" Width="70" Height="15" Text="[PREREQ_DISK_STATUS]">
          <Condition Action="show">PREREQ_DISK_STATUS</Condition>
        </Control>

        <!-- Status Message -->
        <Control Id="StatusMessage" Type="Text" X="25" Y="130" Width="320" Height="40" Text="[PREREQ_MESSAGE]" />

        <!-- Warning Text -->
        <Control Id="WarningText" Type="Text" X="25" Y="180" Width="320" Height="30" Text="Note: PostgreSQL must be installed and running for database creation to succeed. The installer will continue, but you may need to create the database manually if PostgreSQL is not available." />

        <!-- Back button -->
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg">1</Publish>
        </Control>

        <!-- Next button -->
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />

        <!-- Cancel button -->
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>

      </Dialog>
    </UI>
  </Fragment>
</Wix>

# Professional SMART Configuration
# Generated by installer

# Database Configuration
DATABASE_URL=__DATABASE_URL__
DB_HOST=__DB_HOST__
DB_PORT=__DB_PORT__
DB_NAME=__DB_NAME__
DB_USER=__DB_USER__
DB_PASSWORD=__DB_PASSWORD__

# Service Configuration
LOG_LEVEL=info
RUST_LOG=info

# File Processing
INPUT_DIR=__INSTALL_DIR__data\input
PROCESSED_DIR=__INSTALL_DIR__data\processed
ERROR_DIR=__INSTALL_DIR__data\error

# WebSocket Configuration
STREAMING_ENABLE_WEBSOCKET=true
WEBSOCKET_HOST=127.0.0.1:8080

# Worker Configuration
# STAGE2_WORKER_COUNT: Number of parallel workers for Stage 2 processing.
#   Default 4 is sized for an 8 vCPU box co-located with Postgres.
#   Raise this AND MAX_CONCURRENT_ENCOUNTERS AND DB_MAX_CONNECTIONS on larger hardware.
# MAX_CONCURRENT_ENCOUNTERS: Concurrent encounter transactions per worker.
#   workers * MAX_CONCURRENT_ENCOUNTERS must stay under DB_MAX_CONNECTIONS.
# BATCH_SIZE: Claims per batch for processing.
STAGE2_WORKER_COUNT=4
MAX_CONCURRENT_ENCOUNTERS=4
BATCH_SIZE=250

# Rules Engine Configuration
# ENABLE_DATABASE_RULES: Set to true to load rules from database (required for COMPOSITE rules)
# RULE_ENCRYPTION_KEY: Secret key for encrypting/decrypting rule parameters (must match PostgreSQL setting)
ENABLE_DATABASE_RULES=true
RULE_ENCRYPTION_KEY=__RULE_ENCRYPTION_KEY__

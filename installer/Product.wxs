<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <!-- Product Information -->
  <Product Id="*"
           Name="Professional SMART"
           Language="1033"
           Version="1.2.5.0"
           Manufacturer="Professional SMART Team"
           UpgradeCode="9A9E9B9C-9E9F-9A9B-9C9D-9E9F9A9B9C9E">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="Professional SMART Claims Processing System"
             Comments="Automated claims processing, validation, and flagging system for healthcare providers"
             Manufacturer="Professional SMART Team" />

    <!-- Upgrade Logic -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Professional SMART is already installed."
                  Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes" />

    <!-- Media -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Icons -->
    <!-- <Icon Id="ProductIcon" SourceFile="icon.ico" /> -->
    <!-- <Property Id="ARPPRODUCTICON" Value="ProductIcon" /> -->

    <!-- Properties -->
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/professional-smart" />
    <Property Id="ARPCONTACT" Value="support@professional-smart.com" />
    <Property Id="ARPCOMMENTS" Value="Healthcare claims processing system with comprehensive rules engine and RVU-based payment calculations" />

    <!-- Database Configuration Properties -->
    <Property Id="DB_HOST" Value="localhost" />
    <Property Id="DB_PORT" Value="5432" />
    <Property Id="DB_NAME" Value="professional_smart" />
    <Property Id="DB_USER" Value="postgres" />
    <Property Id="DB_PASSWORD" Hidden="yes" />

    <!-- Upgrade Detection Properties -->
    <Property Id="INSTALLMODE" Value="FRESH" />
    <Property Id="DETECTEDVERSION" />
    <Property Id="CREATE_BACKUP" Value="1" />
    <Property Id="ENV_CREDENTIALS_LOADED" Value="0" />


    <!-- Installation Directory -->
    <Directory Id="TARGETDIR" Name="SourceDir">

      <!-- Program Files -->
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Professional SMART">

          <!-- Binaries -->
          <Directory Id="BinFolder" Name="bin">
            <Component Id="MainExecutable" Guid="1A1A1A1A-1B1B-1C1C-1D1D-1E1E1E1E1E1E" Win64="yes">
              <File Id="ProServiceExe"
                    Source="$(var.SolutionDir)target\release\pro-service.exe"
                    KeyPath="yes"
                    Checksum="yes" />

              <!-- Service Installation -->
              <ServiceInstall Id="ServiceInstaller"
                              Type="ownProcess"
                              Name="ProfessionalSMART"
                              DisplayName="Professional SMART Claims Processing Service"
                              Description="Automated claims processing, validation, and flagging system for healthcare providers"
                              Start="auto"
                              Account="LocalSystem"
                              ErrorControl="normal"
                              Arguments="service" />

              <ServiceControl Id="ServiceControl"
                              Start="install"
                              Stop="both"
                              Remove="both"
                              Name="ProfessionalSMART"
                              Wait="no" />
            </Component>

            <Component Id="SetupExecutable" Guid="2B2B2B2B-2C2C-2D2D-2E2E-2F2F2F2F2F2F" Win64="yes">
              <File Id="ProSetupExe"
                    Source="$(var.SolutionDir)target\release\pro-setup.exe"
                    KeyPath="yes"
                    Checksum="yes" />
            </Component>

            <!-- pro-data-loader.exe removed (CLI version not needed) -->
            <!-- pro-data-loader-gui.exe kept (GUI version needed) -->

            <Component Id="DataLoaderGuiExecutable" Guid="4A4A4A4A-4B4B-4C4C-4D4D-4E4E4E4E4E4E" Win64="yes">
              <File Id="ProDataLoaderGuiExe"
                    Source="$(var.SolutionDir)target\release\pro-data-loader-gui.exe"
                    KeyPath="yes"
                    Checksum="yes" />
            </Component>

            <Component Id="UpgradeExecutable" Guid="5A5A5A5A-5B5B-5C5C-5D5D-5E5E5E5E5E5E" Win64="yes">
              <File Id="ProUpgradeExe"
                    Source="$(var.SolutionDir)target\release\pro-upgrade.exe"
                    KeyPath="yes"
                    Checksum="yes" />
            </Component>
            <Component Id="BinDir" Guid="BABABABA-BABB-BABC-BABD-BABABABABABC" Win64="yes">
              <CreateFolder />
              <RemoveFolder Id="RemoveBinFolder" On="uninstall" />
              <RegistryValue Root="HKCU" Key="Software\ProfessionalSMART\Folders" Name="BinDir" Type="integer" Value="1" KeyPath="yes" />
            </Component>
          </Directory>

          <!-- Documentation -->
          <Directory Id="DocsFolder" Name="docs">
            <Component Id="Documentation" Guid="3C3C3C3C-3D3D-3E3E-3F3F-4A4A4A4A4A4A" Win64="yes">
              <File Id="InstallationDoc"
                    Source="$(var.SolutionDir)docs\INSTALLATION.md"
                    KeyPath="yes" />
              <File Id="ConfigurationDoc"
                    Source="$(var.SolutionDir)docs\CONFIGURATION.md" />
              <File Id="DatabaseSetupDoc"
                    Source="$(var.SolutionDir)docs\DATABASE_SETUP.md" />
              <File Id="PerformanceTuningDoc"
                    Source="$(var.SolutionDir)docs\PERFORMANCE_TUNING.md" />
              <File Id="LicenseFile"
                    Source="$(var.SolutionDir)LICENSE" />
            </Component>
          </Directory>

          <!-- Config Templates -->
          <Directory Id="ConfigFolder" Name="config">
            <Component Id="ConfigTemplates" Guid="4B4B4B4B-4C4C-4D4D-4E4E-4F4F4F4F4F4F" Win64="yes">
              <File Id="EnvTemplate"
                    Source="$(var.SolutionDir).env.example"
                    Name=".env.template"
                    KeyPath="yes" />
            </Component>
          </Directory>

          <!-- Data Directories (empty, just create structure) -->
          <Directory Id="DataFolder" Name="data">
            <Directory Id="InputFolder" Name="input">
              <Component Id="InputDir" Guid="5C5C5C5C-5D5D-5E5E-5F5F-6A6A6A6A6A6A" Win64="yes">
                <CreateFolder />
                <RemoveFile Id="RemoveInputFiles" Name="*.*" On="uninstall" />
                <RemoveFolder Id="RemoveInputFolder" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\ProfessionalSMART\Folders" Name="InputDir" Type="integer" Value="1" KeyPath="yes" />
              </Component>
            </Directory>
            <Directory Id="ProcessedFolder" Name="processed">
              <Component Id="ProcessedDir" Guid="6B6B6B6B-6C6C-6D6D-6E6E-6F6F6F6F6F6F" Win64="yes">
                <CreateFolder />
                <RemoveFile Id="RemoveProcessedFiles" Name="*.*" On="uninstall" />
                <RemoveFolder Id="RemoveProcessedFolder" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\ProfessionalSMART\Folders" Name="ProcessedDir" Type="integer" Value="1" KeyPath="yes" />
              </Component>
            </Directory>
            <Directory Id="ErrorFolder" Name="error">
              <Component Id="ErrorDir" Guid="7C7C7C7C-7D7D-7E7E-7F7F-8A8A8A8A8A8A" Win64="yes">
                <CreateFolder />
                <RemoveFile Id="RemoveErrorFiles" Name="*.*" On="uninstall" />
                <RemoveFolder Id="RemoveErrorFolder" On="uninstall" />
                <RegistryValue Root="HKCU" Key="Software\ProfessionalSMART\Folders" Name="ErrorDir" Type="integer" Value="1" KeyPath="yes" />
              </Component>
            </Directory>
            <Component Id="DataDir" Guid="DADADADA-DADB-DADC-DADD-DADADADADADB" Win64="yes">
              <CreateFolder />
              <RemoveFolder Id="RemoveDataFolder" On="uninstall" />
              <RegistryValue Root="HKCU" Key="Software\ProfessionalSMART\Folders" Name="DataDir" Type="integer" Value="1" KeyPath="yes" />
            </Component>
          </Directory>

          <!-- Logs Directory -->
          <Directory Id="LogsFolder" Name="logs">
            <Component Id="LogsDir" Guid="8B8B8B8B-8C8C-8D8D-8E8E-8F8F8F8F8F8F" Win64="yes">
              <CreateFolder />
              <RemoveFile Id="RemoveLogFiles" Name="*.*" On="uninstall" />
              <RemoveFolder Id="RemoveLogsFolder" On="uninstall" />
              <RegistryValue Root="HKCU" Key="Software\ProfessionalSMART\Folders" Name="LogsDir" Type="integer" Value="1" KeyPath="yes" />
            </Component>
          </Directory>

          <!-- Migrations are now embedded in pro-upgrade.exe binary -->
          <!-- No longer need to deploy migration files to disk -->

          <!-- Component to remove the INSTALLFOLDER itself on uninstall -->
          <Component Id="InstallFolderComponent" Guid="FAFAFAFA-FAFB-FAFC-FAFD-FAFAFAFAFABC" Win64="yes">
            <RemoveFolder Id="RemoveINSTALLFOLDER" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\ProfessionalSMART\Folders" Name="InstallFolder" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <!-- ProgramData for configuration -->
      <Directory Id="CommonAppDataFolder">
        <Directory Id="ProgramDataFolder" Name="Professional SMART">
          <Component Id="ProgramDataRoot" Guid="CFCFCFCF-D0D0-D1D1-D2D2-D3D3D3D3D3D3">
            <CreateFolder>
              <Permission User="Users" GenericAll="yes" />
            </CreateFolder>
            <RemoveFolder Id="RemoveProgramDataRoot" On="uninstall" Directory="ProgramDataFolder" />
            <RegistryValue Root="HKCU" Key="Software\ProfessionalSMART" Name="ProgramDataRoot" Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <Directory Id="ProgramDataConfigFolder" Name="config">
            <Component Id="ProgramDataConfig" Guid="9C9C9C9C-9D9D-9E9E-9F9F-AAAAAAAAAAAA">
              <CreateFolder>
                <Permission User="Users" GenericAll="yes" />
              </CreateFolder>
              <RemoveFolder Id="RemoveProgramDataConfig" On="uninstall" />
              <RegistryValue Root="HKCU" Key="Software\ProfessionalSMART" Name="ConfigFolder" Type="integer" Value="1" KeyPath="yes" />
            </Component>
          </Directory>
          <Directory Id="ProgramDataLogsFolder" Name="logs">
            <Component Id="ProgramDataLogs" Guid="ABABABAB-ACAC-ADAD-AEAE-AFAFAFAFAFAF">
              <CreateFolder>
                <Permission User="Users" GenericAll="yes" />
              </CreateFolder>
              <RemoveFolder Id="RemoveProgramDataLogs" On="uninstall" />
              <RegistryValue Root="HKCU" Key="Software\ProfessionalSMART" Name="LogsFolder" Type="integer" Value="1" KeyPath="yes" />
            </Component>
          </Directory>
          <Directory Id="ProgramDataBackupsFolder" Name="backups">
            <Component Id="ProgramDataBackups" Guid="6F6F6F6F-6A6A-6B6B-6C6C-6D6D6D6D6D6D">
              <CreateFolder>
                <Permission User="Users" GenericAll="yes" />
              </CreateFolder>
              <RemoveFolder Id="RemoveProgramDataBackups" On="uninstall" />
              <RegistryValue Root="HKCU" Key="Software\ProfessionalSMART" Name="BackupsFolder" Type="integer" Value="1" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>

      <!-- Start Menu -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Professional SMART">
          <Component Id="ApplicationShortcuts" Guid="BCBCBCBC-BDBD-BEBE-BFBF-CCCCCCCCCCCC">

            <Shortcut Id="ConfigWizardShortcut"
                      Name="Configuration Wizard"
                      Description="Configure Professional SMART settings"
                      Target="[BinFolder]pro-setup.exe"
                      WorkingDirectory="INSTALLFOLDER" />

            <Shortcut Id="DataLoaderShortcut"
                      Name="Load Master Data"
                      Description="Load organizations, facilities, and providers from CSV"
                      Target="[BinFolder]pro-data-loader-gui.exe"
                      WorkingDirectory="INSTALLFOLDER" />

            <Shortcut Id="DocumentationShortcut"
                      Name="Documentation"
                      Description="Professional SMART documentation"
                      Target="[DocsFolder]" />

            <Shortcut Id="UninstallShortcut"
                      Name="Uninstall Professional SMART"
                      Description="Uninstall Professional SMART"
                      Target="[SystemFolder]msiexec.exe"
                      Arguments="/x [ProductCode]" />

            <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />

            <RegistryValue Root="HKCU"
                           Key="Software\ProfessionalSMART"
                           Name="installed"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

    </Directory>

    <!-- Features -->
    <Feature Id="Complete" Level="1"
             Title="Professional SMART"
             Description="Complete installation of Professional SMART claims processing system"
             Display="expand"
             ConfigurableDirectory="INSTALLFOLDER">

      <Feature Id="MainApplication" Level="1"
               Title="Core Application"
               Description="Main application binaries and service"
               Absent="disallow">
        <ComponentRef Id="MainExecutable" />
        <ComponentRef Id="SetupExecutable" />
        <!-- pro-data-loader.exe removed (CLI not needed) -->
        <ComponentRef Id="DataLoaderGuiExecutable" />
        <ComponentRef Id="UpgradeExecutable" />
        <ComponentRef Id="BinDir" />
        <ComponentRef Id="InputDir" />
        <ComponentRef Id="ProcessedDir" />
        <ComponentRef Id="ErrorDir" />
        <ComponentRef Id="DataDir" />
        <ComponentRef Id="LogsDir" />
        <ComponentRef Id="InstallFolderComponent" />
        <!-- Migrations are now embedded in pro-upgrade.exe -->
        <ComponentRef Id="ProgramDataRoot" />
        <ComponentRef Id="ProgramDataConfig" />
        <ComponentRef Id="ProgramDataLogs" />
        <ComponentRef Id="ProgramDataBackups" />
        <ComponentRef Id="VersionRegistryKey" />
      </Feature>

      <Feature Id="Documentation" Level="1"
               Title="Documentation"
               Description="Installation guides, configuration reference, and troubleshooting">
        <ComponentRef Id="Documentation" />
      </Feature>

      <Feature Id="ConfigTemplates" Level="1"
               Title="Configuration Templates"
               Description="Example configuration files">
        <ComponentRef Id="ConfigTemplates" />
      </Feature>

      <Feature Id="StartMenuShortcuts" Level="1"
               Title="Start Menu Shortcuts"
               Description="Shortcuts in the Start Menu">
        <ComponentRef Id="ApplicationShortcuts" />
      </Feature>

    </Feature>

    <!-- Prerequisite Check Properties -->
    <Property Id="PREREQ_PSQL_STATUS" Value="CHECKING" />
    <Property Id="PREREQ_PGSERVICE_STATUS" Value="CHECKING" />
    <Property Id="PREREQ_DISK_STATUS" Value="CHECKING" />
    <Property Id="PREREQ_MESSAGE" Value="Checking prerequisites..." />

    <!-- UI Sequence with Custom Dialogs -->
    <UIRef Id="WixUI_FeatureTree" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <UI>
      <!-- Insert Prerequisite and Database Configuration dialogs -->
      <DialogRef Id="PrerequisiteDlg" />
      <DialogRef Id="DatabaseConfigDlg" />

      <!-- Hide Reset and Disk Usage buttons in CustomizeDlg -->
      <Publish Dialog="CustomizeDlg" Control="Reset" Property="WixUI_InstallMode" Value="Change" Order="1">0</Publish>
      <Publish Dialog="CustomizeDlg" Control="DiskCost" Property="WixUI_InstallMode" Value="Change" Order="1">0</Publish>

      <!-- Run prerequisite check and load credentials BEFORE showing PrerequisiteDlg -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="DoAction" Value="CheckPrerequisitesAction" Order="1">1</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="DoAction" Value="LoadEnvCredentialsAction" Order="2">1</Publish>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="PrerequisiteDlg" Order="3">1</Publish>

      <!-- Change LicenseDlg Next to go to PrerequisiteDlg (if license dialog is used) -->
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="DoAction" Value="CheckPrerequisitesAction" Order="1">LicenseAccepted = "1"</Publish>
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="PrerequisiteDlg" Order="2">LicenseAccepted = "1"</Publish>

      <!-- Run prerequisite check again when coming back from CustomizeDlg -->
      <Publish Dialog="CustomizeDlg" Control="Back" Event="DoAction" Value="CheckPrerequisitesAction" Order="1">1</Publish>
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="PrerequisiteDlg" Order="2">1</Publish>

      <!-- PrerequisiteDlg Next goes to CustomizeDlg -->
      <Publish Dialog="PrerequisiteDlg" Control="Next" Event="NewDialog" Value="CustomizeDlg" Order="1">1</Publish>

      <!-- Change CustomizeDlg Next behavior based on whether credentials were loaded -->
      <!-- If credentials loaded from .env (upgrade), skip DatabaseConfigDlg and go to VerifyReadyDlg -->
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="2">ENV_CREDENTIALS_LOADED = "1"</Publish>
      <!-- Otherwise (fresh install), go to DatabaseConfigDlg -->
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="DatabaseConfigDlg" Order="3">ENV_CREDENTIALS_LOADED = "0"</Publish>

      <!-- Override VerifyReadyDlg back button based on whether credentials were loaded -->
      <!-- If credentials loaded, go back to CustomizeDlg -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="CustomizeDlg" Order="2">ENV_CREDENTIALS_LOADED = "1"</Publish>
      <!-- Otherwise, go back to DatabaseConfigDlg -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="DatabaseConfigDlg" Order="3">ENV_CREDENTIALS_LOADED = "0"</Publish>
    </UI>

    <!-- License -->
    <!-- <WixVariable Id="WixUILicenseRtf" Value="License.rtf" /> -->

    <!-- Custom Actions -->
    <!-- VBScript to check prerequisites -->
    <Binary Id="CheckPrerequisitesScript" SourceFile="CheckPrerequisites.vbs" />

    <CustomAction Id="CheckPrerequisitesAction"
                  BinaryKey="CheckPrerequisitesScript"
                  VBScriptCall="CheckPrerequisites"
                  Execute="immediate"
                  Return="check" />

    <!-- VBScript to write .env configuration file -->
    <Binary Id="WriteConfigScript" SourceFile="WriteConfig.vbs" />

    <!-- Set custom action data for deferred action -->
    <CustomAction Id="SetWriteConfigData"
                  Property="WriteConfigAction"
                  Value="[DB_HOST]|[DB_PORT]|[DB_NAME]|[DB_USER]|[DB_PASSWORD]|[INSTALLFOLDER]|[CommonAppDataFolder]"
                  Execute="immediate" />

    <CustomAction Id="WriteConfigAction"
                  BinaryKey="WriteConfigScript"
                  VBScriptCall="WriteConfig"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />

    <!-- VBScript to detect installation type -->
    <Binary Id="DetectInstallationScript" SourceFile="DetectInstallation.vbs" />

    <CustomAction Id="DetectInstallationAction"
                  BinaryKey="DetectInstallationScript"
                  VBScriptCall="DetectInstallation"
                  Execute="immediate"
                  Return="check" />

    <!-- VBScript to load credentials from .env file -->
    <Binary Id="LoadEnvCredentialsScript" SourceFile="LoadEnvCredentials.vbs" />

    <CustomAction Id="LoadEnvCredentialsAction"
                  BinaryKey="LoadEnvCredentialsScript"
                  VBScriptCall="LoadEnvCredentials"
                  Execute="immediate"
                  Return="check" />

    <!-- VBScript to trim properties -->
    <Binary Id="TrimPropertiesScript" SourceFile="TrimProperties.vbs" />

    <CustomAction Id="TrimDatabaseProperties"
                  BinaryKey="TrimPropertiesScript"
                  VBScriptCall="TrimDatabaseProperties"
                  Execute="immediate"
                  Return="check" />

    <!-- VBScript to create database -->
    <Binary Id="CreateDatabaseScript" SourceFile="CreateDatabase.vbs" />

    <CustomAction Id="SetCreateDatabaseData"
                  Property="CreateDatabaseAction"
                  Value="[DB_HOST]|[DB_PORT]|[DB_NAME]|[DB_USER]|[DB_PASSWORD]|[INSTALLFOLDER]"
                  Execute="immediate" />

    <CustomAction Id="CreateDatabaseAction"
                  BinaryKey="CreateDatabaseScript"
                  VBScriptCall="CreateDatabase"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />

    <!-- VBScript to upgrade database -->
    <Binary Id="UpgradeDatabaseScript" SourceFile="UpgradeDatabase.vbs" />

    <CustomAction Id="SetUpgradeDatabaseData"
                  Property="UpgradeDatabaseAction"
                  Value="[DB_HOST]|[DB_PORT]|[DB_NAME]|[DB_USER]|[DB_PASSWORD]|[INSTALLFOLDER]|[CREATE_BACKUP]"
                  Execute="immediate" />

    <CustomAction Id="UpgradeDatabaseAction"
                  BinaryKey="UpgradeDatabaseScript"
                  VBScriptCall="UpgradeDatabase"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no" />

    <!-- VBScript to stop service on uninstall -->
    <Binary Id="StopServiceScript" SourceFile="StopService.vbs" />

    <CustomAction Id="ForceStopService"
                  BinaryKey="StopServiceScript"
                  VBScriptCall="StopService"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />

    <!-- VBScript to remove ProgramData folder on uninstall -->
    <Binary Id="RemoveProgramDataScript" SourceFile="RemoveProgramData.vbs" />

    <CustomAction Id="SetRemoveProgramDataData"
                  Property="RemoveProgramDataAction"
                  Value="[CommonAppDataFolder]"
                  Execute="immediate" />

    <CustomAction Id="RemoveProgramDataAction"
                  BinaryKey="RemoveProgramDataScript"
                  VBScriptCall="RemoveProgramData"
                  Execute="deferred"
                  Return="ignore"
                  Impersonate="no" />


    <InstallExecuteSequence>
      <!-- Detect installation type early in the sequence -->
      <Custom Action="DetectInstallationAction" After="CostFinalize">NOT Installed OR (Installed AND NOT REMOVE="ALL")</Custom>

      <!-- Trim properties before using them -->
      <Custom Action="TrimDatabaseProperties" After="DetectInstallationAction">NOT REMOVE="ALL"</Custom>

      <!-- Set data for deferred action -->
      <Custom Action="SetWriteConfigData" After="InstallFiles">NOT REMOVE="ALL"</Custom>
      <!-- Write configuration file after folders are created -->
      <Custom Action="WriteConfigAction" After="SetWriteConfigData">NOT REMOVE="ALL"</Custom>

      <!-- Fresh install: Create database after config is written -->
      <!-- Only run if NOT upgrading (WIX_UPGRADE_DETECTED will be set during upgrades) -->
      <Custom Action="SetCreateDatabaseData" After="WriteConfigAction">NOT Installed AND NOT WIX_UPGRADE_DETECTED</Custom>
      <Custom Action="CreateDatabaseAction" After="SetCreateDatabaseData">NOT Installed AND NOT WIX_UPGRADE_DETECTED</Custom>

      <!-- Upgrade: Use upgrade database action right before InstallFinalize -->
      <!-- Only run if upgrading (WIX_UPGRADE_DETECTED is set by MajorUpgrade when older version found) -->
      <Custom Action="SetUpgradeDatabaseData" After="InstallFiles">WIX_UPGRADE_DETECTED</Custom>
      <Custom Action="UpgradeDatabaseAction" After="SetUpgradeDatabaseData">WIX_UPGRADE_DETECTED</Custom>

      <!-- Force stop service at the VERY START of InstallExecuteSequence during uninstall -->
      <Custom Action="ForceStopService" After="InstallInitialize">Installed AND REMOVE="ALL"</Custom>

      <!-- Remove ProgramData folder after removing files -->
      <Custom Action="SetRemoveProgramDataData" After="RemoveFiles">Installed AND REMOVE="ALL"</Custom>
      <Custom Action="RemoveProgramDataAction" After="SetRemoveProgramDataData">Installed AND REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

    <!-- Write registry value to track installed version -->
    <Component Id="VersionRegistryKey" Guid="7E7E7E7E-7F7F-7A7A-7B7B-7C7C7C7C7C7C" Directory="TARGETDIR">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\ProfessionalSMART"
                     Name="Version"
                     Type="string"
                     Value="1.2.1.0"
                     KeyPath="yes" />
    </Component>

  </Product>
</Wix>

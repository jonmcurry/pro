    },
    {
      "target_field": "rendering_provider_npi",
      "transformation_type": { "Custom": { "function_name": "normalize_npi" } }
    },
    {
      "target_field": "diagnosis_code",
      "transformation_type": { "Custom": { "function_name": "clean_icd10" } }
    },
    {
      "target_field": "subscriber_gender",
      "transformation_type": { "Custom": { "function_name": "standardize_gender" } }
    }
  ]
